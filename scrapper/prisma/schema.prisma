generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pelicula {
  id               Int       @id @default(autoincrement())
  titulo           String    @unique
  descripcion      String
  generos          Genero[]
  duracionMinutos  Int
  categoria        Categoria
  cines            Cine[]
  activa           Boolean
  tmdbId           Int?      @unique
  poster_path      String?
  popularidad      Float?
  fechaLanzamiento DateTime?
}

model Cine {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  localidad Localidad
  url       String
  api_url   String?
  peliculas Pelicula[] // las relaciones de primas SIEMPRE deben estar de los dos lados
}

model Genero {
  tmdbId    Int        @id
  nombre    String
  peliculas Pelicula[]
}

enum Localidad {
  CABA
  GBA
}

enum Categoria {
  ESTRENOS
  REESTRENOS
}