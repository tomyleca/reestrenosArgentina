generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pelicula {
  id               Int       @id @default(autoincrement())
  titulo           String    @unique
  descripcion      String
  generos          Genero[]
  duracionMinutos  Int
  categoria        Categoria
  cines            Cine[]
  activa           Boolean
  tmdbId           Int?      @unique
  poster_path      String?
  popularidad      Float?
  fechaLanzamiento DateTime?
  funciones        Funcion[]
}

model Funcion {
  id         Int      @id @default(autoincrement())
  fecha      DateTime
  pelicula   Pelicula @relation(fields: [peliculaId], references: [id])
  peliculaId Int

  @@unique([peliculaId, fecha])
}



model Cine {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  localidad Localidad
  url       String
  api_url   String?
  peliculas Pelicula[] // las relaciones de primas SIEMPRE deben estar de los dos lados
}

model Genero {
  tmdbId    Int        @id
  nombre    String
  peliculas Pelicula[]
}

model Alerta {
  id      String   @id @default(uuid())
  mensaje String
  fecha   DateTime @default(now())
}

enum Localidad {
  CABA
  GBA
  ZONA_SUR
}

enum Categoria {
  ESTRENOS
  REESTRENOS
}