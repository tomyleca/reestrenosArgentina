generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pelicula {
  id               Int       @id @default(autoincrement())
  titulo           String    @unique
  descripcion      String
  duracionMinutos  Int
  categoria        Categoria
  activa           Boolean
  tmdbId           Int?      @unique
  popularidad      Float?
  poster_path      String?
  fechaLanzamiento DateTime?
  funciones        Funcion[]
  cines            Cine[]    @relation("CineToPelicula")
  generos          Genero[]  @relation("GeneroToPelicula")
}

model Funcion {
  id         Int      @id @default(autoincrement())
  fecha      DateTime
  peliculaId Int
  pelicula   Pelicula @relation(fields: [peliculaId], references: [id])

  @@unique([peliculaId, fecha])
}

model Cine {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  localidad Localidad
  url       String
  api_url   String?
  peliculas Pelicula[] @relation("CineToPelicula")
}

model Genero {
  nombre    String
  tmdbId    Int        @id
  peliculas Pelicula[] @relation("GeneroToPelicula")
}

model Alerta {
  id      String   @id @default(uuid())
  mensaje String
  fecha   DateTime @default(now())
}

enum Localidad {
  CABA
  GBA
  ZONA_SUR
}

enum Categoria {
  ESTRENOS
  REESTRENOS
}
