{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Vitest (archivo actual)",
      "program": "${workspaceFolder}/agregadorCines/node_modules/vitest/vitest.mjs",
      "args": ["run", "--config", "vitest.integration.config.ts", "${file}"],
      "cwd": "${workspaceFolder}/agregadorCines",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Vitest (todos)",
      "program": "${workspaceFolder}/agregadorCines/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "cwd": "${workspaceFolder}/agregadorCines",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: agregadorCines (index.ts)",
      "runtimeArgs": ["--loader", "ts-node/esm"],
      "args": ["src/index.ts"],
      "cwd": "${workspaceFolder}/agregadorCines",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
