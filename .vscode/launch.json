{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Vitest (archivo actual)",
      "program": "${workspaceFolder}/scrapper/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "--config",
        "vitest.integration.config.ts",
        "${relativeFile}"
      ],
      "cwd": "${workspaceFolder}/scrapper",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Vitest (todos)",
      "program": "${workspaceFolder}/scrapper/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "cwd": "${workspaceFolder}/scrapper",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: scrapper (index.ts)",
      "runtimeArgs": ["--loader", "ts-node/esm"],
      "args": ["src/index.ts"],
      "cwd": "${workspaceFolder}/scrapper",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
